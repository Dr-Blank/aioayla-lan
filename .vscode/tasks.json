{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "bumpType",
      "type": "pickString",
      "description": "Version part to bump",
      "options": [
        "patch",
        "minor",
        "major"
      ],
      "default": "patch"
    },
    {
      "id": "releaseTag",
      "type": "promptString",
      "description": "Existing tag to (re)publish, e.g. v1.2.3",
      "default": ""
    }
  ],
  "tasks": [
    {
      "label": "Release: Bump Version & Tag",
      "detail": "Bumps pyproject.toml and uv.lock, commits chore(release), and creates the vX.Y.Z tag locally.",
      "type": "shell",
      "command": "./script/release.sh ${input:bumpType}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Release: Push Tags to Origin",
      "detail": "Pushes the release commit and its tag, which triggers the Publish workflow.",
      "type": "shell",
      "command": "git push --follow-tags origin main",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Release: Publish Existing Tag",
      "detail": "Re-runs the Publish workflow for a tag, e.g. after a failed run. Files already on PyPI are skipped.",
      "type": "shell",
      "command": "gh workflow run publish.yaml -f tag=${input:releaseTag}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Test",
      "detail": "Runs the library test suite.",
      "type": "shell",
      "command": "uv run pytest",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Prek",
      "detail": "Runs every hook, tests included, the way CI does.",
      "type": "shell",
      "command": "uv run prek run --all-files --hook-stage manual",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
