{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "timezone": "Asia/Kolkata",
  "schedule": ["before 6am on monday"],
  "platformAutomerge": false,
  "rangeStrategy": "update-lockfile",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "enabled": true
  }
}
